# Copy to .env locally — NEVER commit real secrets.
LIVEKIT_URL=wss://YOUR_PROJECT.livekit.cloud
LIVEKIT_API_KEY=APIxxxx
LIVEKIT_API_SECRET=xxxxx
LIVEKIT_ROOM=chengzhangwu
# Optional overrides:
# XIAOYU_IDENTITY=xiaoyu-listener
# STT_MODEL=deepgram/nova-3
# STT_LANGUAGE=zh
# TTS: xAI Grok voice "liora" (用户口中的 Lyora；与 Grok Bot 通话一致)
# TTS_MODEL=xai/tts-1
# TTS_VOICE=liora
# TTS_LANGUAGE=zh
# LLM via LiveKit Inference (uses LIVEKIT_* — no separate OpenAI key needed)
# LLM_MODEL=openai/gpt-4o-mini
# ENABLE_TTS=1
# ENABLE_LLM=1
# ECHO_COOLDOWN_S=1.2
# CONV_HOLD_S=90
